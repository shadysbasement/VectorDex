; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VectorDex"
config/description="Tactile Cyberpunk Pokedex built with Godot 4 and Ruby"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1180
window/size/viewport_height=760
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=960
window/size/min_height=640

[rendering]

environment/defaults/default_clear_color=Color(0.055, 0.059, 0.071, 1)
textures/vram_compression/import_etc2_astc=true
