; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is also a plain text file.

config_version=5

[application]

config/name="VectorDex"
config/description="Tactile Cyberpunk Pokedex built with Godot 4 and Ruby"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1180
window/size/viewport_height=760
window/size/min_width=960
window/size/min_height=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.055, 0.059, 0.071, 1.0)